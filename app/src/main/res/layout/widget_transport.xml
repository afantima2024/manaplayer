<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_button" android:padding="8dp"
            android:src="@drawable/ic_previous" android:scaleType="centerInside"
            android:contentDescription="@string/previous" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <!-- A thumbnail behind Play retains four full-height controls in one launcher row. -->
            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="2dp" android:scaleType="centerCrop" android:visibility="gone"
                android:tint="#88000000" android:tintMode="src_atop" tools:ignore="UseAppTint"
                android:importantForAccessibility="no" android:contentDescription="@null" />
            <!-- RemoteViews uses framework tinting, not AppCompat attributes. -->
            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/widget_button" android:padding="6dp"
                android:src="@drawable/ic_play" android:scaleType="centerInside" android:tint="#FF80E5D0"
                tools:ignore="UseAppTint"
                android:contentDescription="@string/play" />
        </FrameLayout>
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_button" android:padding="8dp"
            android:src="@drawable/ic_next" android:scaleType="centerInside"
            android:contentDescription="@string/next" />
        <ImageButton
            android:id="@+id/widget_mute"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_button" android:padding="8dp"
            android:src="@drawable/ic_volume_on" android:scaleType="centerInside"
            android:contentDescription="@string/mute_player" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
        android:visibility="gone"
        android:text="@string/widget_time_initial" android:textColor="#FFD1DFE8" android:textSize="12sp" />
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:max="1000" android:progress="0" android:indeterminate="false"
        android:progressDrawable="@drawable/widget_progress" android:background="@null"
        android:contentDescription="@string/seek_position" />
</LinearLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <ScrollView
        android:id="@+id/settingsCategoryScroll"
        android:layout_width="@dimen/settings_category_width"
        android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/settingsCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/categoryGeneral"
                style="@style/SettingCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category_general" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/categoryBackgrounds"
                style="@style/SettingCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category_backgrounds" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/categoryPlayback"
                style="@style/SettingCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category_playback" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/categorySpectrum"
                style="@style/SettingCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/spectrum" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/categoryLyrics"
                style="@style/SettingCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lyrics" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/categoryFolders"
                style="@style/SettingCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/folders" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/categoryAbout"
                style="@style/SettingCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about" />
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="?attr/colorOutline"
        android:alpha="0.4"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/settingsDetails"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/settings_detail_padding"
        android:paddingEnd="@dimen/settings_detail_padding">
        <TextView
            android:id="@+id/settingsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/category_general"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />
        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">
                <LinearLayout
                    android:id="@+id/settingsGeneralPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsLanguage"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language" />
                    <TextView
                        style="@style/SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_transition"
                        android:labelFor="@id/settingsTransition" />
                    <Spinner
                        android:id="@+id/settingsTransition"
                        style="@style/SettingChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsTheme"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsAccent"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_accent" />
                    <TextView
                        style="@style/SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/navigation_position"
                        android:labelFor="@id/settingsNavigationPosition" />
                    <Spinner
                        android:id="@+id/settingsNavigationPosition"
                        style="@style/SettingChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settingsControlBlocks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:text="@string/control_blocks"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />
                    <LinearLayout
                        android:id="@+id/blockStyleControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            style="@style/SettingLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/block_style"
                            android:labelFor="@id/settingsBlockStyle" />
                        <Spinner
                            android:id="@+id/settingsBlockStyle"
                            style="@style/SettingChoice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settingsBlockCharacter"
                            style="@style/SettingButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/block_character" />
                        <LinearLayout
                            android:id="@+id/blockArcControls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/blockArcValue"
                                style="@style/SettingLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/block_arc_value"
                                android:labelFor="@id/blockArc" />
                            <SeekBar
                                android:id="@+id/blockArc"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:max="48"
                                android:contentDescription="@string/block_arc_radius" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/settingsBlockShadow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="@string/block_shadow"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="16dp"
                        android:text="@string/control_blocks_help"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/settingsBackgroundPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsUseCustomTheme"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/background_use_custom" />
                    <LinearLayout
                        android:id="@+id/settingsBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settingsBackgroundImage"
                            style="@style/SettingButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/background_choose" />
                        <TextView
                            android:id="@+id/backgroundSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="16sp"
                            android:padding="8dp" />
                        <LinearLayout
                            android:id="@+id/settingsSlideshow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <TextView
                                android:id="@+id/backgroundIntervalValue"
                                style="@style/SettingLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/background_interval"
                                android:labelFor="@id/backgroundInterval" />
                            <SeekBar
                                android:id="@+id/backgroundInterval"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:max="119"
                                android:contentDescription="@string/background_interval" />
                            <TextView
                                android:id="@+id/backgroundDurationValue"
                                style="@style/SettingLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/background_duration"
                                android:labelFor="@id/backgroundDuration" />
                            <SeekBar
                                android:id="@+id/backgroundDuration"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:max="100"
                                android:contentDescription="@string/background_duration" />
                            <TextView
                                style="@style/SettingLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/background_transition"
                                android:labelFor="@id/backgroundTransition" />
                            <Spinner
                                android:id="@+id/backgroundTransition"
                                style="@style/SettingChoice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="@string/slideshow_help"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="16sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/backgroundBlurValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:text="@string/background_blur"
                            android:labelFor="@id/backgroundBlur" />
                        <SeekBar
                            android:id="@+id/backgroundBlur"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:max="100"
                            android:contentDescription="@string/background_blur" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/settingsBackgroundTint"
                            style="@style/SettingButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/background_tint" />
                        <TextView
                            android:id="@+id/backgroundTintValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:text="@string/background_tint_strength"
                            android:labelFor="@id/backgroundTintStrength" />
                        <SeekBar
                            android:id="@+id/backgroundTintStrength"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:max="100"
                            android:contentDescription="@string/background_tint_strength" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="16dp"
                            android:text="@string/background_help"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/settingsPlaybackPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsLoop"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/loop_mode" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsOrder"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/play_order" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="16dp"
                        android:text="@string/playback_settings_help"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                    <TextView
                        style="@style/SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mini_time_mode"
                        android:labelFor="@id/settingsTimeMode" />
                    <Spinner
                        android:id="@+id/settingsTimeMode"
                        style="@style/SettingChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        style="@style/SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_time_mode"
                        android:labelFor="@id/settingsMainTimeMode" />
                    <Spinner
                        android:id="@+id/settingsMainTimeMode"
                        style="@style/SettingChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/settingsSpectrumPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settingsSpectrum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:text="@string/spectrum_enable"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />
                    <include
                        android:id="@+id/spectrumSettings"
                        layout="@layout/view_spectrum_settings" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/settingsLyricsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settingsLyrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:text="@string/show_lyrics"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />
                    <TextView
                        style="@style/SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lyrics_landscape_position"
                        android:labelFor="@id/lyricsLandscapePosition" />
                    <Spinner
                        android:id="@+id/lyricsLandscapePosition"
                        style="@style/SettingChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        style="@style/SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lyrics_portrait_position"
                        android:labelFor="@id/lyricsPortraitPosition" />
                    <Spinner
                        android:id="@+id/lyricsPortraitPosition"
                        style="@style/SettingChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settingsOnlineLyrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:text="@string/search_online_lyrics"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/lyricsProviderOrder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settingsLyricDragSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:text="@string/lyrics_drag_seek"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="@string/lyrics_drag_help"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settingsLyricSmoothScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:text="@string/lyrics_smooth_scroll"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp" />
                    <TextView
                        style="@style/SettingLabel"
                        android:id="@+id/lyricActiveSizeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lyric_active_size"
                        android:labelFor="@id/lyricActiveSize" />
                    <SeekBar
                        android:id="@+id/lyricActiveSize"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="@string/lyric_active_size"
                        android:max="36"
                        android:progress="12" />
                    <TextView
                        android:id="@+id/lyricOtherSizeValue"
                        style="@style/SettingLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lyric_other_size"
                        android:labelFor="@id/lyricOtherSize" />
                    <SeekBar
                        android:id="@+id/lyricOtherSize"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="@string/lyric_other_size"
                        android:max="36"
                        android:progress="8" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lyricActiveColor"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lyric_active_color" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lyricOtherColor"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lyric_other_color" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lyricResetAppearance"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lyric_reset_appearance" />
                    <TextView
                        android:id="@+id/lyricsCacheLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:textIsSelectable="true"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="16dp"
                        android:text="@string/lyrics_help"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/settingsFoldersPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsFolders"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_folders" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsPinFolders"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pin_folders" />
                    <TextView
                        android:id="@+id/settingsFolderSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="@string/multiple_folders_help"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsDeviceMusic"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_music" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsAddFolder"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/add_folder" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsPlayFolders"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/play_selected_folders" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsManageFolders"
                        style="@style/SettingButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/manage_folders" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/settingsAboutPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>

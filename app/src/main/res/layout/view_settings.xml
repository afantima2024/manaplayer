<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsLanguage"
            style="@style/SettingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/language" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsTheme"
            style="@style/SettingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsLoop"
            style="@style/SettingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loop_mode" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsOrder"
            style="@style/SettingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_order" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="@string/playback_settings_help"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsFolders"
            style="@style/SettingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_folders" />
        <TextView
            android:id="@+id/settingsFolderSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/multiple_folders_help"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsAddFolder"
            style="@style/SettingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_folder" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsPlayFolders"
            style="@style/SettingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_selected_folders" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsManageFolders"
            style="@style/SettingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_folders" />
    </LinearLayout>
</ScrollView>
